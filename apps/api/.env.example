DATABASE_URL=postgresql://postgres:password@localhost:5432/talentflow
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-min-64-chars
JWT_REFRESH_SECRET=change-me-refresh-min-64-chars
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Mailbox-integraties (settings/integrations) ────────────────────────────
# Base-URLs voor de OAuth-redirect en de terugkeer naar de web-app. Zonder
# API_BASE_URL valt de redirect-uri terug op http://localhost:4000.
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Gmail / Google Workspace OAuth (Google Cloud Console → OAuth 2.0 Client ID,
# type "Web application"). ZONDER deze twee draait Gmail in mock-mode en toont
# de UI "Gmail-koppeling is nog niet geconfigureerd" (knop disabled).
#   Redirect-URI die je in Google moet whitelisten:
#     ${API_BASE_URL}/api/integrations/mailbox/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optioneel — override de redirect-uri (default = API_BASE_URL + callback-pad).
GOOGLE_OAUTH_REDIRECT_URI=

# Outlook / Microsoft 365 OAuth (Azure Portal → App registrations → client
# secret). Dekt zowel Outlook.com als Microsoft 365 (Microsoft Graph). ZONDER
# deze twee draait Outlook/M365 in mock-mode (knop disabled in de UI).
#   Redirect-URI die je in Azure moet whitelisten (type "Web"):
#     ${API_BASE_URL}/api/integrations/mailbox/oauth/callback
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Optioneel — 'common' (default) werkt voor work + personal accounts; zet een
# specifieke tenant-id voor single-tenant M365.
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/common
# Optioneel — override de redirect-uri (default = API_BASE_URL + callback-pad).
AZURE_AD_REDIRECT_URI=
