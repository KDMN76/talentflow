# =============================================================================
# TalentFlow — Production environment template
# =============================================================================
# Copy to `.env.prod` next to this file and fill in real values:
#   cp infra/.env.prod.example infra/.env.prod
#   chmod 600 infra/.env.prod
#
# `.env.prod` is gitignored — never commit secrets. On the VPS, lifecycle:
#   - Generated once during the first deploy
#   - Backed up to a password manager (1Password / Bitwarden)
#   - Rotated every 90 days for JWT_*, REDIS_PASSWORD, STORAGE_S3_SECRET_KEY
#
# Generate strong secrets with:
#   openssl rand -hex 32
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=talentflow
POSTGRES_PASSWORD=<change-me-strong-password>
POSTGRES_DB=talentflow
DATABASE_URL=postgresql://talentflow:<change-me-strong-password>@postgres:5432/talentflow

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=<change-me-strong-password>
REDIS_URL=redis://:<change-me-strong-password>@redis:6379

# ── JWT (generate each with `openssl rand -hex 32`) ──────────────────────────
JWT_SECRET=<64-char-hex>
JWT_REFRESH_SECRET=<64-char-hex>

# ── AI providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Email (Resend — leeg laten voor mock-mode) ────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=TalentFlow <noreply@talentflow.kdmn.nl>
RESEND_REPLY_DOMAIN=reply.talentflow.kdmn.nl
RESEND_WEBHOOK_SECRET=

# ── Storage (MinIO / S3) ─────────────────────────────────────────────────────
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_BUCKET=talentflow
STORAGE_S3_ACCESS_KEY=<change-me-min-20-chars>
STORAGE_S3_SECRET_KEY=<change-me-min-40-chars>
STORAGE_S3_REGION=eu-central-1

# ── Sentry (error tracking) ──────────────────────────────────────────────────
SENTRY_DSN_API=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENV=production

# ── Application config ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Same-origin deploy: web + api both behind https://talentflow.kdmn.nl/
# Nginx forwards /api/* → :4000 (api), everything else → :3000 (web).
CORS_ORIGIN=https://talentflow.kdmn.nl
NEXT_PUBLIC_API_URL=https://talentflow.kdmn.nl/api
NEXT_PUBLIC_USE_MOCK_DATA=false

# ── Workers (Q1.2) ───────────────────────────────────────────────────────────
# In productie draaien API en BullMQ-workers in losse containers (zie
# docker-compose.prod.yml — `api` vs `api-worker`). De `api` service heeft
# DISABLE_INLINE_WORKERS=true hardcoded; deze env-var is hier puur ter
# documentatie. Zet 'true' om inline worker-startup over te slaan op een
# proces dat ook BullMQ-events in een aparte container verwerkt. Lokaal dev
# (npm run dev): leeg laten zodat workers inline draaien.
DISABLE_INLINE_WORKERS=true

# ── Backup destination (Cloudflare R2 — see infra/backup.sh) ─────────────────
# Cloudflare R2 is S3-compatible. Create a bucket + API token in the R2 dash
# (https://dash.cloudflare.com/?to=/:account/r2). Lifecycle: 30-day retention.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY=
BACKUP_R2_SECRET_KEY=
BACKUP_R2_BUCKET=talentflow-backups
BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Optional: Slack/Discord deploy notifications
DEPLOY_NOTIFY_WEBHOOK=
