# 	@portalPath path /portal/* /api/portal/*
# 	handle @portalPath {
# 		reverse_proxy api:4000
# 	}
#
# 	handle {
# 		# Default to web — career-pages SSR live there at /careers/[slug]
# 		reverse_proxy web:3000
# 	}
# }
