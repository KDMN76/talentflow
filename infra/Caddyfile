# TalentFlow — Caddy reverse proxy
#
# Caddy auto-renews Let's Encrypt certificates and terminates TLS.
# Internal services (api, web) speak plain HTTP on the docker network.
#
# On-demand TLS for custom career-page domains is wired but commented out.
# It needs the `/api/portal/verify-domain` endpoint (Q2 deliverable). Until
# that ships, we only serve the apex + api subdomain.

{
	email admin@talentflow.app

	# ── On-demand TLS — UNCOMMENT WHEN PORTAL VERIFY ENDPOINT EXISTS (Q2) ──
	# on_demand_tls {
	# 	ask http://api:4000/api/portal/verify-domain
	# 	interval 2m
	# 	burst 5
	# }

	# Tighter logging in prod — Caddy's default is fine but we want JSON
	# for log shippers later (Loki / Datadog).
	log {
		output stdout
		format json
		level INFO
	}
}

# ── Marketing site + dashboard ──────────────────────────────────────────────
talentflow.app, www.talentflow.app {
	encode gzip zstd

	# www -> apex redirect
	@www host www.talentflow.app
	redir @www https://talentflow.app{uri} permanent

	header {
		# Security headers (Next.js handles its own CSP)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# ── REST API ────────────────────────────────────────────────────────────────
api.talentflow.app {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	reverse_proxy api:4000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
		# Long-running requests for AI parsing / matching
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}
}

# ── On-demand TLS catch-all for custom domains (Q2) ─────────────────────────
# Career pages and white-label customer portals will point CNAMEs here.
# Caddy obtains a cert per domain on first request after `ask` returns 200.
#
# UNCOMMENT TOGETHER WITH THE on_demand_tls BLOCK ABOVE.
